# Optional infrastructure runtime configuration.
FLUXMEM_POSTGRES_DB=fluxmem
FLUXMEM_POSTGRES_USER=fluxmem
FLUXMEM_POSTGRES_PASSWORD=fluxmem_dev
FLUXMEM_POSTGRES_PORT=5433
FLUXMEM_DATABASE_URL=postgresql+psycopg://fluxmem:fluxmem_dev@127.0.0.1:5433/fluxmem

OPENROUTER_API_KEY=

# The infrastructure runtime uses this model for answering and memory LLM tasks
# unless a task-specific override below is uncommented.
FLUXMEM_LLM_MODEL=deepseek/deepseek-v4-flash-0731
FLUXMEM_EMBEDDING_MODEL=openai/text-embedding-3-small
# FLUXMEM_ANSWER_MODEL=deepseek/deepseek-v4-flash-0731
# FLUXMEM_EXTRACTION_MODEL=deepseek/deepseek-v4-flash-0731
# FLUXMEM_RECONCILIATION_MODEL=deepseek/deepseek-v4-flash-0731
# FLUXMEM_LIFECYCLE_MODEL=deepseek/deepseek-v4-flash-0731

# Optional OpenRouter attribution and local tuning.
OPENROUTER_APP_NAME=FluxMem Local
# OPENROUTER_HTTP_REFERER=http://localhost
FLUXMEM_LLM_TIMEOUT_SECONDS=60
FLUXMEM_LLM_MAX_OUTPUT_TOKENS=2048
FLUXMEM_MEMORY_HISTORY_MESSAGES=128
FLUXMEM_ANSWER_HISTORY_MESSAGES=128
FLUXMEM_ANSWER_INPUT_TOKEN_BUDGET=64000
FLUXMEM_EMBEDDING_TIMEOUT_SECONDS=30
FLUXMEM_OPENROUTER_PROMPT_CACHING=true

# FluxMem validates structured responses locally and performs at most one
# repair request when server-enforced JSON Schema is disabled.
FLUXMEM_OPENROUTER_STRICT_JSON_SCHEMA=false

# Prototype rollout switches.
FLUXMEM_ENABLE_MEMORY_EXTRACTION=true
FLUXMEM_ENABLE_MEMORY_WRITES=true
FLUXMEM_ENABLE_CONFLICT_DETECTION=true
FLUXMEM_ENABLE_LLM_LIFECYCLE=true
